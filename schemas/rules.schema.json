{
  "type": "object",
  "description": "Business rules recovered from one legacy stored procedure bundle.",
  "properties": {
    "module": {
      "type": "string",
      "maxLength": 80
    },
    "rules": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/contradiction"
      },
      "description": "Places where a comment or header says one thing and the code does another."
    },
    "open_questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 400
      },
      "description": "Behaviour a rule owner should confirm as intended."
    }
  },
  "required": [
    "module",
    "rules",
    "contradictions",
    "open_questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 12,
          "description": "RULE-01, RULE-02, ..."
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "enum": [
            "rate",
            "accrual",
            "billing",
            "payment_waterfall",
            "fee",
            "penal_interest",
            "calendar",
            "classification",
            "prepayment",
            "closure",
            "error_handling",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "maxLength": 600,
          "description": "What the code does, in plain language, as it actually behaves."
        },
        "source": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "File name as given in the request"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "file",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "statement",
        "source",
        "confidence",
        "notes"
      ],
      "additionalProperties": false
    },
    "contradiction": {
      "type": "object",
      "properties": {
        "comment_source": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "File name as given in the request"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "file",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "code_source": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "File name as given in the request"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "file",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "comment_source",
        "code_source",
        "description"
      ],
      "additionalProperties": false
    }
  }
}
